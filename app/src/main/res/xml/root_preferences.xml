<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/app_name">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="isRecordNotificationEnabled"
            app:summary="@string/notification_assistant_service_summary"
            app:title="@string/notification_assistant_service" />
        <Preference
            app:key="open_onboarding"
            app:summary="@string/onboarding"
            app:title="@string/onboarding" />
        <Preference
            app:key="open_permissions"
            app:title="@string/permissions" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/notification_collection_apps">
        <Preference
            app:key="open_collection_apps"
            app:summary="@string/notification_collection_apps_summary"
            app:title="@string/notification_collection_apps" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/export_import">
        <Preference
            app:key="export_db"
            app:summary="@string/exports_the_notification_database_to_a_password_encrypted_file"
            app:title="@string/export" />
        <Preference
            app:key="import_db"
            app:summary="@string/import_notification_database_password_generated_during_export_required"
            app:title="@string/import_string" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/notification_agent">
        <Preference
            app:key="open_agent_settings"
            app:summary="@string/agent_service_settings_summary"
            app:title="@string/agent_service_settings" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/info">
        <Preference
            app:key="open_about"
            app:summary="@string/about_summary"
            app:title="@string/about" />
    </PreferenceCategory>
</PreferenceScreen>