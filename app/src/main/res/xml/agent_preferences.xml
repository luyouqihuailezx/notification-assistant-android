<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/agent_service_settings">
        <EditTextPreference
            app:key="agent_base_url"
            app:title="@string/agent_base_url"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="agent_model"
            app:title="@string/agent_model"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="agent_token"
            app:title="@string/agent_api_token" />
    </PreferenceCategory>
</PreferenceScreen>
